# Copiar como .env y poner la API key de https://restcountries.com
RESTCOUNTRIES_API_KEY=TU_API_KEY

# Dominios desde los que el servidor puede renderizar (SSR), separados por comas.
# localhost ya está permitido en angular.json; agrega aquí el dominio real al publicar.
# NG_ALLOWED_HOSTS=mi-dominio.com,www.mi-dominio.com
